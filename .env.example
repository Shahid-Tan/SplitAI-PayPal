# SplitAI environment variables — example file
#
# 1. Copy this file to  .env
# 2. Fill in any values you need
# 3. NEVER commit .env (it is git-ignored)
#
# .env is loaded automatically at startup via python-dotenv.
# Equivalent values can instead live in .streamlit/secrets.toml — see
# .streamlit/secrets.toml.example. Secrets take the same priority either way.

# --- Gemini (optional; without it the deterministic parser is used) --------
GEMINI_API_KEY=your-gemini-api-key

# --- PayPal sandbox REST app (optional; without it PayPal.me links are used)
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# --- Optional tuning -------------------------------------------------------
# Default PayPal.me handle for fallback settlement links.
PAYPAL_ME_HANDLE=syedshahidafridi
# Business email attached to created orders.
PAYPAL_PAYEE_EMAIL=your-sandbox-business@example.com
# Public base URL for PayPal approval redirects (needed behind a tunnel).
# APP_BASE_URL=https://your-tunnel-host.example.org
# API endpoint override; sandbox by default (swap for live later on purpose).
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
