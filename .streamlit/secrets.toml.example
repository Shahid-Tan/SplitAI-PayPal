# SplitAI secrets — example file
#
# 1. Copy this file to  .streamlit/secrets.toml
# 2. Fill in your keys
# 3. NEVER commit .streamlit/secrets.toml (it is git-ignored)
#
# Deployed apps (Streamlit Community Cloud, etc.) use the same shape in the
# app's "Secrets" settings panel. Every section is optional: omit [gemini] and
# SplitAI runs the honest deterministic parser; omit [paypal] and settlement
# falls back to prefilled PayPal.me links.

[gemini]
# Optional — enables the Gemini engine. Get a free key at
# https://aistudio.google.com/app/apikey
api_key = "your-gemini-api-key"

[paypal]
# PayPal developer SANDBOX REST credentials from https://developer.paypal.com
# → Apps & Credentials → Sandbox → Live? no, keep "Sandbox" → create app.
# With both values set, every transfer gets a real Orders v2 approval link.
client_id = "AYSq3RDGsmBLJE-otTkBtM-jBRd1HCT2iNgCCCCCC"   # example shape only
client_secret = "EGnHDxD_qRPd-LyMXXXXXXXXXXXXXXXXXXXXX"   # example shape only

# Optional: email attached to created orders (must be the sandbox business
# account email) and the default PayPal.me handle for fallback links.
payee_email = "your-sandbox-business@example.com"
me_handle = "syedshahidafridi"
